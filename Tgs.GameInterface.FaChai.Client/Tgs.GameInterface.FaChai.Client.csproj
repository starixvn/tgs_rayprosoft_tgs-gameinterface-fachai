<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net7.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>0.0.7</Version>
		<Authors>Raypro</Authors>
		<RootNamespace>Tgs.GameInterface.FaChai.Client</RootNamespace>
		<PackageId>Tgs.GameInterface.FaChai.Client</PackageId>
		<Title>Tgs.GameInterface.FaChai.Client</Title>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-fachai</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-fachai.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Tgs GameInterface FaChai Client</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.55.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.55.0" />
		<PackageReference Include="Grpc.Tools" Version="2.57.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="..\Tgs.GameInterface.FaChai\Protos\gameinterfacefachai.proto">
			<Link>gameinterfacefachai.proto</Link>
		</Protobuf>
	</ItemGroup>
</Project>
